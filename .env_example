# Copy to .env, then fill in the pieces you use. Nothing here is required to
# run the portfolio ledger; the defaults in src/config.py are usable as-is.

# Where the database and user state live.
# SKARBIE_HOME=~/Documents/skarbie

# Where the broker snapshot that seeds the database is read from.
# Defaults to $SKARBIE_HOME/seed_snapshot.toml. Copy seed_snapshot.example.toml
# there and fill in your own figures; it holds real holdings and is never
# committed.
#
# How far the derived book may sit from the broker's stated total before
# seeding refuses to write. Guards against a mistyped figure.
# SKARBIE_SEED_RECONCILIATION_TOLERANCE_EUR=1.0

# Default new money per month for a NEWLY CREATED profile. The live figure is
# per-profile in profiles.toml, since two people do not contribute the same
# amount. Actual money added is a cash_flow row and is what really binds.
# SKARBIE_DEFAULT_MONTHLY_CONTRIBUTION_EUR=150

# Portfolio guardrails. Defaults are sized for a ~EUR 1,400 portfolio of 14
# positions, where equal weight is ~7%. src/config.py documents why each value
# is what it is; that file owns the defaults and this one does not repeat them.
# SKARBIE_MAX_POSITION_WEIGHT_PCT=20
# SKARBIE_LARGE_POSITION_WEIGHT_PCT=12
# SKARBIE_MAX_NEW_TRADE_EUR=100
# SKARBIE_MAX_WEEKLY_ALLOCATION_EUR=100
# SKARBIE_CONCENTRATION_ALERT_PCT=40
# SKARBIE_RECOMMENDATION_EXPIRY_DAYS=7

# Market data. yfinance is free and needs no key; it is scraped rather than
# licensed, so it sits behind an abstraction and occasionally breaks.
# SKARBIE_MARKET_DATA_PROVIDER=yfinance
# How much history to request to find one usable close. Not a window of
# interest — only the latest close is kept.
# SKARBIE_MARKET_DATA_LOOKBACK=5d
# Age at which a stored price is reported as stale instead of used silently.
# SKARBIE_PRICE_STALE_AFTER_DAYS=4

# Curated events live in $SKARBIE_HOME/profiles/<name>/events.toml, not here.
# See events.example.toml in the project root.

# Where the facts an analysis reasons over come from. Free news aggregation
# by default, no key needed. It gives provenance — a URL, a date, a publisher —
# but not quality: a headline establishes that something was said, not that it
# is true. Sourced claims require a supplied evidence ID and exact excerpt;
# model knowledge is stored as 'background' and may not pose as a current fact.
# SKARBIE_EVIDENCE_SOURCE=yfinance-news
# SKARBIE_EVIDENCE_ITEMS_PER_SECURITY=8

# Provider key. Z.ai serves both default tiers; litellm reads this name.
ZAI_API_KEY=

# Second provider, used for the fallback. A fallback within one provider
# survives a bad model but not an outage, which is the failure that would take
# a whole weekly run with it.
OPENAI_API_KEY=

# Further providers, for when the multi-model panel needs genuinely different
# labs. Any litellm model id works in the routing table, so adding one is a
# key here plus 'main.py models set FEATURE --model ID'.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Model routing. Defaults are cheap on purpose: on a portfolio this size a
# weekly run on premium models can cost more per year than it returns. See
# 'main.py models' for what is in force and 'main.py models cost' for spend.
# flash and pro reason before answering; fast does not, which is why fast is
# the fallback rather than a cheaper substitute for analysis.
# SKARBIE_FLASH_MODEL=zai/glm-5.3-flash
# SKARBIE_FAST_MODEL=openai/gpt-5.6-luna
# SKARBIE_PRO_MODEL=zai/glm-4.7
# SKARBIE_MAX_TOKENS_DEFAULT=4000
# Floor under any output budget. GLM always reasons and cannot be told not to;
# too small a budget is spent entirely on thinking and returns nothing.
# SKARBIE_MIN_MAX_TOKENS=1024
# Output budget for a thesis restatement. Measured, not chosen: at 3,000
# tokens eight of fourteen bootstrap calls were truncated mid-reasoning and
# had to be retried, paying for each twice.
# SKARBIE_THESIS_MAX_TOKENS=9000
# Output budget for the portfolio decision — the largest of any stage.
# Deciding across fourteen holdings at once produced ~8,600 tokens of
# reasoning before the answer even began.
# SKARBIE_DECISION_MAX_TOKENS=20000
# SKARBIE_TRUNCATION_RETRY_MULTIPLIER=2.5
# SKARBIE_LLM_TIMEOUT_S=180
# ZAI_API_KEY=

# Telegram bot. One bot serves every profile — people are told apart by the
# numeric telegram_id in profiles.toml, not by having a bot each. Get a token
# by messaging @BotFather.
TELEGRAM_BOT_TOKEN=
# SKARBIE_TELEGRAM_TIMEOUT_S=20
# Long-poll wait and backoff for the listener daemon.
# SKARBIE_DAEMON_POLL_TIMEOUT_S=30
# SKARBIE_DAEMON_ERROR_BACKOFF_S=15

# When the scheduled weekly run fires. Sunday evening by default: the
# week's news has landed, markets are shut so nothing moves mid-run, and
# there is a day before Monday's open to think about anything proposed.
# Weekday is launchd-style, Sunday = 0.
# SKARBIE_WEEKLY_RUN_WEEKDAY=0
# SKARBIE_WEEKLY_RUN_HOUR=18
# How often the daemon asks whether the week's run has happened. The check
# is a state question, not a clock comparison, so a coarse interval costs
# lateness and never a missed week.
# SKARBIE_SCHEDULED_CHECK_INTERVAL_S=1800

# The passive alternative the portfolio is measured against. A global
# all-world tracker quoted in EUR, so the comparison needs no currency
# conversion and takes no view on which region should have been held.
# SKARBIE_BENCHMARK_TICKER=VWCE.DE
# SKARBIE_BENCHMARK_NAME=FTSE All-World (accumulating)
# How long before the comparison is worth reading as anything but noise.
# SKARBIE_BENCHMARK_MEANINGFUL_AFTER_DAYS=1095

# Where the background jobs write output. Defaults to ~/Library/Logs,
# which is the macOS convention and where Console.app looks.
# SKARBIE_LOG_FILE=

# Research coverage and review workflow. Inspect effective values with main.py process.
# SKARBIE_RESEARCH_MAX_PASSES=4
# SKARBIE_RESEARCH_OVERDUE_DAYS=42
# SKARBIE_SNOOZE_DAYS=2
# SKARBIE_EVIDENCE_MAX_AGE_DAYS=120
# Primary excerpts: per-profile context/evidence.json; see docs/commands.md.
